 "limitation": "The rational-benchmark corpus (data/mechanisms/position_adjustment/events_all.parquet and nonevent_days.parquet) only covers calendar dates 2025-10-02 to 2026-09-17. Four of the five BASE trajectory windows (val_calm 2023-10-02, val_stress 2024-07-22, test_crash 2025-04-01, test_bear 2022-05-02, plus the test_crash replicate) fall entirely outside that range and get a 0% rational join -- confirmed by direct check, not assumed. Only the test_calm window (2026-01-05 to 2026-01-26, 40 held-out stocks, 2 twin trajectories each) overlaps the benchmark's coverage, so ALL regression/ratio/rank numbers above come from that one window only. This is a real corpus-coverage constraint, not a bug: it is reported here rather than forcing a cross-window result.",
 "method": {
  "eventful_threshold": "|u| >= 2.0",
  "k_base": 283.60093315058083,
  "k_choice": "k chosen so std(unclipped k*m/sigma^2) over the joined, usable sample equals std(agent exposure_pct) over that same sample; sensitivity to k reported via k_half/k_double and via Spearman rank correlation of the deltas, which is scale-invariant",
  "quiet_threshold": "|u| < 1.0 (u = standardized surprise from events_all/nonevent_days, at day t)",
  "rational_rule": "rational_target_pct[t] = clip(k * m[t] / exp(lsig[t])**2, 0, 100); delta_rational[t] = rational_target[t] - rational_target[t-1] using the same k/clip",
  "scope": "BASE policy only (Qwen3.5-9B tool agent, default prompt); files listed in base_files_loaded below"
 },
