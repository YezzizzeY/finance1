# The host values of the original pilot run (2026-10-18). The shipped records contain these paths (they are what the coding
# agents saw, except that the experiment folder was renamed to 1_overreaction afterwards and the new name substituted in
# both places; see records/README.md, "Path rename"); the re-audit of the shipped coding runs (`finagent audit`, verify L2)
# reads them.
# The keys of host.example.env, plus CODEX_REAL_BIN and PROJECT_DIR, which describe the original layout.

WS_ROOT=/srv/shared_home/lmz/cxpw
AGENT_PYENV=${WS_ROOT}/pyenv
AGENT_PATH=${AGENT_PYENV}/bin:/usr/local/bin:/usr/bin:/bin
CODEX_BIN=/srv/shared_home/lmz/.local/bin/codex
CODEX_PACKAGE_DIR=/srv/shared_home/lmz/.codex/packages/standalone/releases/0.162.1-x86_64-unknown-linux-musl
# realpath of CODEX_BIN (its codex-path/ folder holds the bundled rg that 7 flagged runs executed)
CODEX_REAL_BIN=/srv/shared_home/lmz/.codex/packages/standalone/releases/0.162.1-x86_64-unknown-linux-musl/bin/codex
CODEX_HOME_ROOT=/srv/shared_home/lmz/ai/work2_llm_agent_behavior/1_overreaction/results/codexpilot_20261018/codex_home
SANDBOX_PYTHON=/usr/bin/python3
RUNNER_PYTHON=/srv/shared_home/lmz/ai/work2_llm_agent_behavior/1_overreaction/.venv/bin/python
PRIVATE_ROOT=/srv/shared_home/lmz/ai
# the original project folder (sandbox.py, relay and run folders lived under it)
PROJECT_DIR=/srv/shared_home/lmz/ai/work2_llm_agent_behavior/1_overreaction

VLLM_ENV=/srv/shared_home/lmz/ai/work2_llm_agent_behavior/0_model_server/.venv-vllm
