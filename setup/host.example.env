# Host settings for new runs. Copy this file, edit the values and set FINAGENT_HOST_ENV=<your copy>.
# Format: KEY=VALUE, one per line; ${NAME} expands an earlier key, an environment variable or REPO_ROOT (the repository).
# An environment variable FINAGENT_<KEY> (for example FINAGENT_GPU=1) overrides the value of KEY written here.
# API keys are never read from this file: export DEEPSEEK_API_KEY and MOONSHOT_API_KEY (names in setup/models.toml).

# Coding agents. Each run works in <WS_ROOT>/<12 random letters>/work, which the agent sees as its cwd: keep it short and neutral.
WS_ROOT=/tmp/cxpw
# Python 3.12 venv with numpy and pandas only (setup/scripts/setup_agent_env.sh, setup/requirements/agent-env.txt), first on the agent's PATH
AGENT_PYENV=${WS_ROOT}/pyenv
AGENT_PATH=${AGENT_PYENV}/bin:/usr/local/bin:/usr/bin:/bin
# codex-cli 0.162.1, unpacked into CODEX_PACKAGE_DIR by setup/scripts/install_codex.sh; one CODEX_HOME per run under CODEX_HOME_ROOT/runs/<rid>
CODEX_PACKAGE_DIR=${HOME}/.local/share/finagent/codex-0.162.1-x86_64-unknown-linux-musl
CODEX_BIN=${CODEX_PACKAGE_DIR}/bin/codex
CODEX_HOME_ROOT=${REPO_ROOT}/runs/codex_home
# interpreter of sandbox.py (standard library + libseccomp.so.2)
SANDBOX_PYTHON=/usr/bin/python3
# interpreter of the relay (empty: the interpreter running finagent)
RUNNER_PYTHON=
# folders the audit flags as "project folders" when a coding agent opens a path inside them
PRIVATE_ROOT=${REPO_ROOT}

# vLLM (setup/scripts/setup_vllm_env.sh, setup/scripts/download_weights.sh)
VLLM_ENV=${REPO_ROOT}/.venv-vllm
MODEL_DIR=${HOME}/models
VLLM_CACHE_DIR=${HOME}/.cache/finagent
# short TMPDIR for vLLM (its ZMQ socket path must stay under 107 bytes)
VLLM_SHORT_TMP=/tmp/finagent-vllm
# empty: the card with the most free memory, utilisation from its free memory
GPU=
GPU_UTIL=

# ports (127.0.0.1 only): vLLM servers, and the relays the coding agents reach their model through
VLLM_PORT_QWEN3_8B=18580
VLLM_PORT_QWEN35_9B=18581
VLLM_PORT_QWEN38_27B=18582
RELAY_PORT_QWEN3_8B=18590
RELAY_PORT_QWEN35_9B=18591
RELAY_PORT_DEEPSEEK=18592
RELAY_PORT_KIMI=18594
RELAY_PORT_QWEN38_27B=18595
